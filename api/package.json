{
    "name": "sophie-api",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "test": "vitest run --config vitest.config.ts",
        "test:coverage": "vitest run --config vitest.config.ts --coverage",
        "test:watch": "vitest --config vitest.config.ts",
        "db:push": "node node_modules/.bin/drizzle-kit push",
        "create-user": "tsx scripts/create-user.ts",
        "db:generate": "node node_modules/.bin/drizzle-kit generate",
        "db:migrate": "node node_modules/.bin/drizzle-kit migrate",
        "db:studio": "node node_modules/.bin/drizzle-kit studio",
        "auth:schema": "better-auth generate --config src/auth.ts --output src/db/auth.schema.ts --yes"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.1",
        "better-auth": "~1.6.29",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.2",
        "postgres": "^3.4.9"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "^12.1.0",
        "@types/node": "^26",
        "@vitest/coverage-v8": "^4.1.10",
        "drizzle-kit": "^0.31.10",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
